# Copy this file to .env and fill in what you use. Never commit .env.

# Script writing. Keys set here override keys saved in Settings.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Set to 1 on a shared server. Keys must then come from this file or the server's
# environment, and the personal Claude plan is turned off.
VYRAL_HOSTED=0

# Accounts on a hosted server (VYRAL_HOSTED=1). Set up with: uv run python -m vyral.migrate
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# The address people use to reach Vyral, used in sign-in emails.
VYRAL_PUBLIC_URL=http://localhost:8765
# Emails that can change app-wide settings, separated by commas.
VYRAL_ADMIN_EMAILS=

# Limits for each user. These are the defaults.
VYRAL_MONTHLY_VIDEOS=20
VYRAL_MONTHLY_AI_REQUESTS=50
VYRAL_MAX_PROJECTS=25
VYRAL_MAX_UPLOAD_MB=50
VYRAL_MAX_FILES_PER_PROJECT=60
